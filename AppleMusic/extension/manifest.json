{
  "manifest_version": 3,
  "name": "moOde Apple Music bridge",
  "version": "2.1",
  "description": "Return button, moOde theme, renderer and remote integration, and lighter Apple Music rendering for the Raspberry Pi.",
  "permissions": [
    "declarativeNetRequest"
  ],
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "light",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://music.apple.com/*",
        "https://*.music.apple.com/*"
      ],
      "js": [
        "nowebgl.js",
        "volume.js",
        "nowplaying.js",
        "idle.js"
      ],
      "run_at": "document_start",
      "world": "MAIN",
      "all_frames": true
    },
    {
      "matches": [
        "https://music.apple.com/*",
        "https://*.music.apple.com/*"
      ],
      "js": [
        "content.js",
        "theme.js",
        "siri-overlay.js"
      ],
      "css": [
        "content.css",
        "siri-overlay.css"
      ],
      "run_at": "document_start"
    }
  ],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*"
  ]
}
