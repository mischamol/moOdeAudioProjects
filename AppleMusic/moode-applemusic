#!/bin/bash
# moode-applemusic: open/close Apple Music Web on the moOde local display.
#
#   sudo moode-applemusic open [--debug]   start Apple Music on the local display
#   sudo moode-applemusic hide             hide it (music keeps playing; moOde UI is shown)
#   sudo moode-applemusic show             show it again
#   sudo moode-applemusic close            close it
#   sudo moode-applemusic status           print "running", "hidden" or "stopped"
#
# Apple Music runs in its own Chromium profile, so moOde's cache clearing at
# every display start does not log you out. Audio goes to moOde's _audioout
# ALSA device, which follows moOde's output chain (CamillaDSP -> DigiPi+).
set -u

UNIT=moode-applemusic
CONF=/etc/default/moode-applemusic
EXTENSION=/opt/moode-applemusic/extension

APPLEMUSIC_URL=https://music.apple.com/nl/home
APPLEMUSIC_ALSA_DEVICE=_audioout
APPLEMUSIC_SCALE=
APPLEMUSIC_STOP_MPD=yes
APPLEMUSIC_FREEZE_MOODE=no
APPLEMUSIC_EXTRA_FLAGS=
APPLEMUSIC_COLOR_SCHEME=auto
APPLEMUSIC_LANGUAGE=
# shellcheck disable=SC1090
[ -r "$CONF" ] && . "$CONF"

die() { echo "moode-applemusic: $*" >&2; exit 1; }
[ "$(id -u)" -eq 0 ] || die "run as root (sudo)"

display_user=$(systemctl show -p User --value localdisplay.service 2>/dev/null)
[ -n "$display_user" ] || die "cannot determine the local display user"
display_home=$(getent passwd "$display_user" | cut -d: -f6)
profile="$display_home/.config/moode-applemusic"

is_running() { systemctl is-active --quiet "$UNIT"; }

# Runtime state shared with /var/www/applemusic.php (tmpfs, not the SD card).
RUN_DIR=/dev/shm/moode-applemusic
is_hidden() { [ -e "$RUN_DIR/hidden" ]; }

# "‹ moOde" hides the Apple Music window instead of closing it: music keeps
# playing and reopening is instant. There is no window manager, so the
# windows are unmapped and mapped again with xdotool.
xdo() { runuser -u "$display_user" -- env DISPLAY=:0 xdotool "$@"; }
app_windows() {
    local pid
    pid=$(systemctl show -p MainPID --value "$UNIT" 2>/dev/null)
    [ -n "$pid" ] && [ "$pid" -gt 0 ] || return 0
    xdo search --onlyvisible --pid "$pid" 2>/dev/null || true
}
cmd_hide() {
    if ! is_running; then echo stopped; return 0; fi
    local ids id
    install -d -m 1777 "$RUN_DIR"
    ids=$(app_windows)
    [ -n "$ids" ] && printf '%s\n' "$ids" > "$RUN_DIR/windows"
    for id in $ids; do xdo windowunmap "$id" >/dev/null 2>&1 || true; done
    touch "$RUN_DIR/hidden"
    echo hidden
}
cmd_show() {
    if ! is_running; then echo stopped; return 1; fi
    local id
    if [ -r "$RUN_DIR/windows" ]; then
        for id in $(cat "$RUN_DIR/windows"); do
            xdo windowmap "$id" >/dev/null 2>&1 || true
            xdo windowraise "$id" >/dev/null 2>&1 || true
        done
    fi
    rm -f "$RUN_DIR/hidden"
    echo running
}

# Reuse window size and scale of moOde's own kiosk browser, so Apple Music
# covers exactly the same area.
moode_browser_geometry() {
    local pid args
    for pid in $(pgrep -u "$display_user" -f -- '--app=http://localhost/'); do
        args=$(tr '\0' '\n' < "/proc/$pid/cmdline" 2>/dev/null) || continue
        size=$(printf '%s\n' "$args" | sed -n 's/^--window-size=//p' | head -n1)
        scale=$(printf '%s\n' "$args" | sed -n 's/^--force-device-scale-factor=//p' | head -n1)
        [ -n "$size" ] && return 0
    done
    return 1
}

# moOde's own browser keeps running underneath Apple Music. Pausing it while
# Apple Music is open gives the CPU to Apple Music and CamillaDSP.
moode_browser_pids() {
    local main
    main=$(pgrep -o -u "$display_user" -f -- '--app=http://localhost/') || return 0
    echo "$main"
    pgrep -u "$display_user" -f -- '--type=' | while read -r pid; do
        local parent=$pid
        while [ -n "$parent" ] && [ "$parent" -gt 1 ]; do
            [ "$parent" = "$main" ] && { echo "$pid"; break; }
            parent=$(awk '{print $4}' "/proc/$parent/stat" 2>/dev/null)
        done
    done
}
freeze_moode() { moode_browser_pids | xargs -r kill -STOP 2>/dev/null || true; }
thaw_moode()   { moode_browser_pids | xargs -r kill -CONT 2>/dev/null || true; }

# The Apple Music volume slider sets CamillaDSP directly. After Apple Music
# closes, return CamillaDSP to moOde's own volume, as moOde does after AirPlay.
restore_moode_volume() {
    local sync
    sync=$(moodeutl -q "SELECT value FROM cfg_system WHERE param='camilladsp_volume_sync'" 2>/dev/null)
    /var/www/util/vol.sh -restore >/dev/null 2>&1 || true
    if [ "$sync" = on ]; then
        systemctl restart mpd2cdspvolume >/dev/null 2>&1 || true
    fi
}
# After a pause Chromium keeps the audio device open for ~15 s, so MPD cannot
# play yet. Restarting Chromium's audio process (it is restarted on demand)
# frees the device within a second.
release_audio() {
    is_running || return 0
    local cg pid i
    cg=/sys/fs/cgroup$(systemctl show -p ControlGroup --value "$UNIT" 2>/dev/null)
    [ -r "$cg/cgroup.procs" ] || return 0
    for pid in $(cat "$cg/cgroup.procs"); do
        grep -qa 'audio.mojom.AudioService' "/proc/$pid/cmdline" 2>/dev/null && kill "$pid" 2>/dev/null
    done
    for i in $(seq 1 30); do
        grep -qs RUNNING /proc/asound/card*/pcm*p/sub*/status || break
        sleep 0.1
    done
    echo released
}

after_close() { thaw_moode; rm -rf "$RUN_DIR"; restore_moode_volume; }

cmd_open() {
    local debug=no
    [ "${1:-}" = "--debug" ] && debug=yes

    if is_running; then
        cmd_show
        return 0
    fi
    systemctl reset-failed "$UNIT" >/dev/null 2>&1 || true
    rm -rf "$RUN_DIR"
    install -d -m 1777 "$RUN_DIR"

    if [ "$APPLEMUSIC_STOP_MPD" = yes ]; then
        mpc -q stop >/dev/null 2>&1 || true
    fi

    size=""; scale=""
    # moOde's browser may still be starting (e.g. right after a display restart).
    local i
    for i in $(seq 1 20); do
        moode_browser_geometry && break
        sleep 1
    done
    if [ -z "$size" ]; then
        local res
        res=$(DISPLAY=:0 xdpyinfo 2>/dev/null | awk '/dimensions:/ {print $2}')
        [ -n "$res" ] || die "local display is not running"
        scale=1
        size="${res%x*},${res#*x}"
    fi
    if [ -n "$APPLEMUSIC_SCALE" ] && [ -n "$scale" ]; then
        # Keep the same physical window, recompute CSS size for the new scale.
        local w h
        w=$(awk -v a="${size%,*}" -v s="$scale" -v n="$APPLEMUSIC_SCALE" 'BEGIN{printf "%d", a*s/n}')
        h=$(awk -v a="${size#*,}" -v s="$scale" -v n="$APPLEMUSIC_SCALE" 'BEGIN{printf "%d", a*s/n}')
        size="$w,$h"; scale="$APPLEMUSIC_SCALE"
    fi
    scale=${scale:-1}

    install -d -o "$display_user" -g "$display_user" -m 0700 "$profile"
    # Chromium writes an index for the network rules into the extension
    # folder, so it needs a writable copy owned by the display user. The folder
    # name follows the content: Chromium keeps using a cached service worker
    # for an unchanged extension path, even after its files changed.
    local hash ext_copy
    hash=$(cat "$EXTENSION"/* | md5sum | cut -c1-10)
    ext_copy="$profile/moode-extension-$hash"
    rm -rf "$profile"/moode-extension "$profile"/moode-extension-*
    cp -r "$EXTENSION" "$ext_copy"
    chown -R "$display_user:$display_user" "$ext_copy"

    # Interface language, e.g. en-GB: Apple Music keeps the country's store
    # (catalogue, subscription) and switches the language with ?l=.
    local url="$APPLEMUSIC_URL"
    local -a lang_args=()
    if [ -n "$APPLEMUSIC_LANGUAGE" ]; then
        case "$url" in
            *[?\&]l=*) ;;
            *\?*) url="$url&l=$APPLEMUSIC_LANGUAGE" ;;
            *)    url="$url?l=$APPLEMUSIC_LANGUAGE" ;;
        esac
        lang_args=(--lang="$APPLEMUSIC_LANGUAGE" --accept-lang="$APPLEMUSIC_LANGUAGE")
    fi

    local -a args=(
        --user-data-dir="$profile"
        --app="$url"
        "${lang_args[@]}"
        --kiosk
        --window-position=0,0
        --window-size="$size"
        --force-device-scale-factor="$scale"
        --alsa-output-device="$APPLEMUSIC_ALSA_DEVICE"
        --autoplay-policy=no-user-gesture-required
        # Keep the page's timers running while its window is hidden, so the
        # moOde controls keep working.
        --disable-background-timer-throttling
        --disable-renderer-backgrounding
        --disable-backgrounding-occluded-windows
        --force-prefers-reduced-motion
        --load-extension="$ext_copy"
        --enable-features=OverlayScrollbar
        --disable-features=Translate,MediaRouter
        --no-first-run
        --no-default-browser-check
        --noerrdialogs
        --disable-infobars
        --disable-session-crashed-bubble
        --password-store=basic
    )
    # Light or dark Apple Music, like the moOde theme (light text = dark theme).
    local scheme="$APPLEMUSIC_COLOR_SCHEME" tx
    if [ "$scheme" = auto ]; then
        tx=$(moodeutl -q "SELECT tx_color FROM cfg_theme WHERE theme_name=(SELECT value FROM cfg_system WHERE param='themename')" 2>/dev/null)
        case "$tx" in [89a-fA-F]*) scheme=dark ;; *) scheme=light ;; esac
    fi
    [ "$scheme" = dark ] && args+=(--force-dark-mode)
    [ "$debug" = yes ] && args+=(--remote-debugging-port=9222)
    # shellcheck disable=SC2206
    [ -n "$APPLEMUSIC_EXTRA_FLAGS" ] && args+=($APPLEMUSIC_EXTRA_FLAGS)

    systemd-run --quiet --collect --unit="$UNIT" \
        --uid="$display_user" --gid="$display_user" \
        --working-directory="$display_home" \
        --setenv=DISPLAY=:0 --setenv=HOME="$display_home" \
        --setenv=PULSE_SERVER=/nonexistent \
        -p KillMode=mixed -p TimeoutStopSec=8 \
        -p "ExecStopPost=+/usr/local/bin/moode-applemusic after-close" \
        /usr/bin/chromium-browser "${args[@]}" \
        || die "failed to start Chromium"
    if [ "$APPLEMUSIC_FREEZE_MOODE" = yes ]; then
        # Give Apple Music time to cover the screen before pausing moOde.
        ( sleep 6; is_running && freeze_moode ) >/dev/null 2>&1 &
    fi
    echo "started"
}

cmd_close() {
    if is_running; then
        systemctl stop "$UNIT"
    fi
    systemctl reset-failed "$UNIT" >/dev/null 2>&1 || true
    thaw_moode
    echo "stopped"
}

case "${1:-}" in
    open)   shift; cmd_open "$@" ;;
    close)  cmd_close ;;
    hide)   cmd_hide ;;
    show)   cmd_show ;;
    toggle) if ! is_running; then cmd_open; elif is_hidden; then cmd_show; else cmd_hide; fi ;;
    status) if ! is_running; then echo stopped; elif is_hidden; then echo hidden; else echo running; fi ;;
    thaw-moode) thaw_moode ;;
    after-close) after_close ;;
    release-audio) release_audio ;;
    *) echo "Usage: sudo moode-applemusic open [--debug] | hide | show | close | toggle | status" >&2; exit 2 ;;
esac
